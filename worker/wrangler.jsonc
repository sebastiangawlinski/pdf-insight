{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pdf-insight-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // Jawne (nie-sekretne) ustawienia. Klucz API ustawiasz osobno:
  //   npx wrangler secret put LLM_API_KEY --config worker/wrangler.jsonc
  "vars": {
    "LLM_BASE_URL": "https://api.groq.com/openai/v1",
    "LLM_MODEL": "meta-llama/llama-4-scout-17b-16e-instruct",
    "ALLOWED_ORIGINS": "https://sebastiangawlinski.github.io",
  },

  // Limit żądań: 6 analiz na minutę na adres IP.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 6, "period": 60 },
    },
  ],
}
